<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.mhdr1zky.MyGdrive</id>
  <name>MyGdrive Rust</name>
  <summary>Sync Google Drive folders and choose offline files</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.mhdr1zky"><name>MyGdrive Rust contributors</name></developer>
  <description>
    <p>A Linux Google Drive client with a GTK dashboard, two-way folder synchronization, offline file selection, and conflict recovery.</p>
    <p>The Flatpak package supports local folders and offline selection. Native FUSE mounting, Thunar actions, and automatic login startup are available separately in the Debian package.</p>
    <p>Google OAuth desktop credentials are supplied by the user. This independent project is not affiliated with Google.</p>
  </description>
  <launchable type="desktop-id">io.github.mhdr1zky.MyGdrive.desktop</launchable>
  <url type="homepage">https://github.com/mhdr1zky/MyGdrive-Rust</url>
  <url type="bugtracker">https://github.com/mhdr1zky/MyGdrive-Rust/issues</url>
  <content_rating type="oars-1.1"/>
  <releases><release version="@VERSION@" date="2026-10-25"/></releases>
</component>
